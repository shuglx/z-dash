{
  "name": "z-dash",
  "version": "1.4.1",
  "description": "Z-DASH — 程序员个人工作台 (桌面版)",
  "homepage": "https://github.com/shuglx/z-dash",
  "main": "main.js",
  "author": "Ryan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb --arm64"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.ryan.zdash",
    "productName": "Z-DASH",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "about.html",
      "build-info.json",
      "assets/**/*",
      "icon.png",
      "icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        { "target": "deb", "arch": ["arm64"] }
      ],
      "category": "Utility",
      "icon": "icon.png",
      "maintainer": "Ryan <z-dash@localhost>",
      "artifactName": "z-dash_${version}_${arch}.deb"
    },
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "icon.ico"
    }
  }
}
